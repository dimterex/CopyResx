<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net5.0</TargetFramework>
        <RootNamespace>CopyToLocates.Resx</RootNamespace>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>..\CopyToLocales\bin\Debug\net5.0-windows\Modules\</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <OutputPath>..\CopyToLocales\bin\Release\net5.0-windows\Modules\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\CopyToLocale.Core\CopyToLocale.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="System.Composition.AttributedModel" Version="6.0.0-rc.2.21480.5" />
    </ItemGroup>

</Project>
